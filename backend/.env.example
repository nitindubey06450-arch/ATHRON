# =============================================
# AETHROM BOT — Backend Environment Variables
# =============================================
# Copy this file to .env and fill in your keys

# OpenAI API Key — get it from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# MongoDB Connection URL — get it from https://cloud.mongodb.com
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/aethrom?retryWrites=true&w=majority
