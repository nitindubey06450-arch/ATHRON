# ===========================
# AETHROM BOT — .gitignore
# ===========================

# --- Environment / Secrets ---
.env
.env.local
.env.development
.env.production
*.env

# --- Node Modules ---
node_modules/
backend/node_modules/
frontend/node_modules/

# --- Build Output ---
frontend/dist/
frontend/build/

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- OS Files (Mac/Windows) ---
.DS_Store
._.DS_Store
._*
Thumbs.db

# --- Editor ---
.vscode/
.idea/
*.swp
*.swo

# --- Misc ---
.sf/
*.pem
